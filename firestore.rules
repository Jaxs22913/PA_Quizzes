rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Each signed-in user can only read/write their own synced data --
    // everything else is denied by default. See cloud-sync.js: each
    // localStorage key becomes one doc at users/{uid}/kv/{encodedKey}.
    match /users/{userId}/kv/{docId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Group Study (Kahoot-style live sessions). Both hosts and joining
    // players use Firebase Anonymous Auth (silent, no popup, no Google
    // account needed to join per product decision) purely so there's a
    // stable uid these rules can check -- state itself is readable by
    // anyone with the room code (no login wall to even watch), but only
    // the host can advance game state, and each player can only write
    // their own player doc (their own nickname/score/answers).
    match /gameRooms/{roomCode} {
      allow read: if true;
      allow create: if request.auth != null && request.resource.data.hostUid == request.auth.uid;
      allow update: if request.auth != null && resource.data.hostUid == request.auth.uid;
      allow delete: if false;

      match /players/{playerId} {
        allow read: if true;
        allow create, update: if request.auth != null && request.auth.uid == playerId;
        allow delete: if false;
      }
    }

    // "Who's studying now" (presence.js). Each doc is just a heartbeat
    // timestamp under the viewer's own uid -- no name, no note content, no
    // sign of *who* specifically, so an open read is no different in kind
    // from gameRooms' own open read above. Only the owning uid can write
    // (or delete, e.g. on sign-out) their own doc.
    match /presence/{guideId}/viewers/{uid} {
      allow read: if true;
      allow write, delete: if request.auth != null && request.auth.uid == uid;
    }

    // Shared highlights (opt-in, theme.js's highlighting IIFE). Each doc is
    // a highlighted span's position (idx/start/end) plus the owning uid --
    // deliberately NEVER the note text, which stays local-only/private even
    // when shared highlights are on. Doc IDs are client-chosen
    // (`${uid}_${idx}_${start}_${end}`) purely so re-saving the same exact
    // range overwrites instead of duplicating; the *actual* access control
    // is the uid field check below, not the doc ID.
    match /sharedHighlights/{guideId}/marks/{markId} {
      allow read: if true;
      allow create, update: if request.auth != null && request.resource.data.uid == request.auth.uid;
      allow delete: if request.auth != null && resource.data.uid == request.auth.uid;
    }

    // Class-wide cumulative "questions answered" counter (class-stats.js): a
    // single shared doc that finishing any quiz increments. Writes are OPEN
    // (not auth-gated) on purpose -- most homepage/quiz visitors are not
    // signed in (Google sign-in is opt-in; presence/group-study are the only
    // things that establish auth), so requiring auth would block their
    // increments. It's constrained to the counter's own numeric field so the
    // doc can't be abused as arbitrary open storage; deletes are denied. A
    // casual engagement metric, client-trusted like gameRooms scoring -- not
    // authoritative data.
    match /stats/global {
      allow read: if true;
      allow write: if request.resource.data.questionsCompleted is number;
      allow delete: if false;
    }

    // RETIRED 2026-10-10: the append-only log of the counter above. Each row held a
    // quiz path, a random per-tab id and a server timestamp, and the collection was
    // readable by anyone; Jaxon's privacy rule for usage numbers is day-level at most,
    // never a per-event time. The anonymous daily totals (metrics_daily) replace it.
    // No client may add rows or read the old ones; they can be deleted from the
    // Firebase console (Firestore Database, stats_events, Delete collection).
    match /stats_events/{eventId} {
      allow read, write: if false;
    }

    // Per-option response distribution (class-stats.js recordPick/getPicks).
    // One doc per question -- answer_picks/<quizslug>__<stem hash> -- holding a
    // running count per option index plus a total. This is what lets a quiz
    // show "72% of the class picked B" beside each choice, the way the
    // reference exam items Jaxon works from do.
    //
    // Open for the same reason the counter and its log are: most quiz-page
    // visitors are never signed in, so an auth gate would record only a
    // minority and the percentages would describe the wrong population.
    //
    // The guard is shape and direction, not identity. hasOnly() stops the
    // collection being used as arbitrary storage; the totals must stay whole,
    // non-negative and bounded; and an update may never LOWER the total, so
    // the distribution can only ever be added to. Deletion is denied outright.
    // Nothing here prevents someone deliberately stuffing a count -- these are
    // study percentages, not a graded record, and the same tradeoff was already
    // accepted for the class counter.
    match /answer_picks/{questionId} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(
                         ['total','opts','c0','c1','c2','c3','c4','c5'])
                    && request.resource.data.total is int
                    && request.resource.data.total >= 1
                    && request.resource.data.total <= 5
                    && request.resource.data.opts is int
                    && request.resource.data.opts >= 2
                    && request.resource.data.opts <= 6;
      allow update: if request.resource.data.keys().hasOnly(
                         ['total','opts','c0','c1','c2','c3','c4','c5'])
                    && request.resource.data.total is int
                    && request.resource.data.total >= resource.data.total
                    && request.resource.data.total <= 200000
                    && request.resource.data.opts is int
                    && request.resource.data.opts >= 2
                    && request.resource.data.opts <= 6;
      allow delete: if false;
    }

    // Anonymous usage counts (metrics.js, added 2026-10-10). One document per day,
    // metrics_daily/{YYYY-MM-DD}, holding ONLY integer counters: no question text, answers,
    // names, emails, uids, IPs, device ids, page addresses or per-event times, ever. The
    // client buffers counts on the device and sends them as one increment() write at most
    // every few minutes; nothing is ever read back.
    //
    //   - only a signed-in Firebase session may write (students who never signed in with
    //     Google get a silent anonymous session, exactly like Group Study);
    //   - only the listed fields, each raised by a small positive amount per write (a
    //     distinct-student counter by exactly 1), never lowered;
    //   - only a day document near today (36 days back, for counts that waited on a
    //     device that was offline, to 1 day ahead, for time zones);
    //   - no client may read or delete it. Jaxon reads it with tools/usage_report.py,
    //     which uses an admin credential and never writes.
    function metricsDayOk(day) {
      let p = day.split('-');
      let t = timestamp.date(int(p[0]), int(p[1]), int(p[2]));
      return day.matches('20[2-9][0-9]-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])')
          && t > request.time - duration.value(36, 'd')
          && t < request.time + duration.value(2, 'd');
    }
    // the field is untouched, or it went up by 1..cap
    function metricsBump(f, cap) {
      let now = request.resource.data.get(f, 0);
      let was = resource == null ? 0 : resource.data.get(f, 0);
      return now == was || (now is int && now > was && now <= was + cap);
    }
    match /metrics_daily/{day} {
      allow read, delete: if false;
      allow create, update: if request.auth != null
        && metricsDayOk(day)
        && request.resource.data.keys().hasOnly(['q_answered', 'quiz_done', 'guide_open',
             'cram_open', 'ref_open', 'arcade_session', 'review_drill', 'planner_day',
             'active_d', 'active_w', 'active_m'])
        && metricsBump('q_answered', 1000) && metricsBump('quiz_done', 50)
        && metricsBump('guide_open', 100) && metricsBump('cram_open', 100)
        && metricsBump('ref_open', 100) && metricsBump('arcade_session', 100)
        && metricsBump('review_drill', 50) && metricsBump('planner_day', 1)
        && metricsBump('active_d', 1) && metricsBump('active_w', 1)
        && metricsBump('active_m', 1);
    }
  }
}
