# Cloudflare response headers for PA Quizzes. HTML, JS, CSS and JSON keep the
# default "public, max-age=0, must-revalidate" (ETag revalidation), because file
# names carry no content hash and class content must never go stale. Media is
# safe to hold briefly: images are almost never replaced in place.

# Every host: match GitHub Pages, which sends "Access-Control-Allow-Origin: *" on
# every file (the site is public; this keeps cross-origin fetches of site JSON
# working the same on both hosts).
#
# Since the cutover (2026-10-10) pa-quizzes.com is the site, so it may be indexed.
/*
  Access-Control-Allow-Origin: *

# Keep the preview hosts out of search results for good (the real site is pa-quizzes.com).
https://:worker.:subdomain.workers.dev/*
  X-Robots-Tag: noindex

/*.png
  ! Cache-Control
  Cache-Control: public, max-age=3600
/*.jpg
  ! Cache-Control
  Cache-Control: public, max-age=3600
/*.jpeg
  ! Cache-Control
  Cache-Control: public, max-age=3600
/*.webp
  ! Cache-Control
  Cache-Control: public, max-age=3600
/*.svg
  ! Cache-Control
  Cache-Control: public, max-age=3600
/*.mp3
  ! Cache-Control
  Cache-Control: public, max-age=86400

# Files under an immutable/ folder are never edited in place (a changed file gets a new
# name), so browsers may keep them for a year without re-checking. sw.js serves the same
# folder cache-first.
/PA_Quizzes/immutable/*
  ! Cache-Control
  Cache-Control: public, max-age=31536000, immutable

# The service worker must always be re-checked so an update is never missed.
/PA_Quizzes/sw.js
  ! Cache-Control
  Cache-Control: no-cache
