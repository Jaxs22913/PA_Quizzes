.DS_Store

# audio audition candidates -- kept locally for listening, not shipped
audio/_cands/

# iCloud Drive conflict copies. Until 2026-07-29 this repo sat under
# ~/Documents, which has iCloud Desktop & Documents sync on, so a build that
# rewrote hundreds of files at once left "<name> 2.js" / "<name> 3.html" copies
# behind. They twice nearly got committed as junk. The clone now lives at
# ~/Developer/PA_Quizzes, outside iCloud, so new ones should not appear; the
# rules stay as a guard in case the repo or a copy of it lands in a synced
# folder again. No real file here has a space in its name, so these patterns
# are safe. Clean any that turn up with:
#   python3 tools/clean_sync_dupes.py --apply
* [0-9].*
* [0-9][0-9].*

# sweep report output, regenerated on every run
tools/console_errors.json

# Python bytecode caches from the tools/ build scripts.
__pycache__/
*.pyc
